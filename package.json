{
  "name": "gitspar",
  "version": "0.3.0",
  "description": "Verified Change Understanding CLI for AI-assisted code changes",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gitspar": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "git",
    "ai",
    "code-review",
    "vibe-coding",
    "mutation-testing",
    "verification",
    "vitest",
    "ast"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run test",
    "receipt": "tsx -e \"import fs from 'node:fs'; console.log(fs.readFileSync('.gitspar/PR_RECEIPT.md', 'utf8'))\"",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "experiment": "tsx scripts/run-experiment.ts"
  },
  "dependencies": {
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
