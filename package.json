{
  "name": "gitspar",
  "version": "0.2.0",
  "description": "Verified Change Understanding CLI for AI-assisted code changes",
  "type": "module",
  "bin": {
    "gitspar": "./dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run",
    "receipt": "tsx -e \"import fs from 'node:fs'; console.log(fs.readFileSync('.gitspar/PR_RECEIPT.md', 'utf8'))\""
  },
  "dependencies": {
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
